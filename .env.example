# Copiar a .env (no se versiona) y pegar el contenido PEM de las claves JWT entre comillas dobles.
# Generarlas con: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#                 openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
BUILDSHIELD_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"
BUILDSHIELD_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"

{
  "info": {
    "name": "BuildShield Microservicios - E2E (gateway)",
    "description": "Colección E2E contra el API Gateway (http://localhost:8080). Etapa A: comprobaciones del gateway, registro (US01), inicio de sesión (US02), usuarios (US04), obra, almacén y material (US14 a US16) y asignaciones (US17). Las peticiones de negocio vienen de la colección Sprint 2 de buildshield-core sin cambios de ruta: el gateway enruta cada prefijo a su microservicio. Las etapas B y C agregan stock, pedidos, saga de reserva, despacho, recepción, discrepancias, notificaciones y auditoría. Ejecutar las carpetas en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Gateway",
      "item": [
        {
          "name": "Salud del gateway",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200 UP\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql(\"UP\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Ruta protegida sin token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401 UNAUTHENTICATED\", function () {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.json().code).to.eql(\"UNAUTHENTICATED\");",
                  "});",
                  "pm.test(\"Trae X-Correlation-Id\", function () {",
                  "    pm.response.to.have.header(\"X-Correlation-Id\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Propaga X-Correlation-Id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "postman-{{runId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"runId\")) {",
                  "    pm.collectionVariables.set(\"runId\", Date.now().toString().slice(-9));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Devuelve el mismo X-Correlation-Id\", function () {",
                  "    pm.expect(pm.response.headers.get(\"X-Correlation-Id\")).to.eql(\"postman-\" + pm.collectionVariables.get(\"runId\"));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Registro de la organización (US01)",
      "item": [
        {
          "name": "Registrar organización y administrador",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Datos nuevos en cada corrida: RUC, correos y SKU no se repiten.",
                  "const runId = Date.now().toString().slice(-9);",
                  "pm.collectionVariables.set(\"runId\", runId);",
                  "pm.collectionVariables.set(\"ruc\", \"20\" + runId);",
                  "pm.collectionVariables.set(\"adminEmail\", \"admin.\" + runId + \"@andina.pe\");",
                  "pm.collectionVariables.set(\"siteManagerEmail\", \"obra.\" + runId + \"@andina.pe\");",
                  "pm.collectionVariables.set(\"warehouseManagerEmail\", \"almacen.\" + runId + \"@andina.pe\");",
                  "pm.collectionVariables.set(\"sku\", \"CEM-\" + runId);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"organizationId\", body.organizationId);",
                  "pm.collectionVariables.set(\"adminId\", body.administratorId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/sign-up",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "sign-up"
              ]
            },
            "description": "Crea la organización (RUC de 11 dígitos) y su administrador en una transacción.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ruc\": \"{{ruc}}\",\n  \"legalName\": \"Constructora Andina {{runId}} SAC\",\n  \"adminFullName\": \"Ana Torres\",\n  \"adminEmail\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Registrar el mismo RUC otra vez (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 409\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"Código RUC_ALREADY_REGISTERED\", function () {",
                  "    pm.expect(body.code).to.eql(\"RUC_ALREADY_REGISTERED\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/sign-up",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "sign-up"
              ]
            },
            "description": "El RUC es único.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ruc\": \"{{ruc}}\",\n  \"legalName\": \"Otra empresa SAC\",\n  \"adminFullName\": \"Otra Persona\",\n  \"adminEmail\": \"otra.{{runId}}@andina.pe\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
